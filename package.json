{
  "name": "trae-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/start.mjs",
    "start:clean": "node scripts/start.mjs --clean",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "serve:install": "node scripts/serve.mjs install",
    "serve:start": "node scripts/serve.mjs start",
    "serve:stop": "node scripts/serve.mjs stop",
    "serve:status": "node scripts/serve.mjs status",
    "serve:uninstall": "node scripts/serve.mjs uninstall",
    "serve:rebuild": "node scripts/serve.mjs rebuild",
    "serve:autostart": "node scripts/serve.mjs autostart",
    "deploy": "vercel --prod --yes",
    "build:portable": "node scripts/build-portable.mjs",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/publish-release.ps1"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "mathjs": "^15.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2",
    "three": "^0.185.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.6",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
